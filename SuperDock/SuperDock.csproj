<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.8.2</Version><AssemblyName>Windock</AssemblyName><ApplicationIcon>Assets\logo.ico</ApplicationIcon><Company>windock</Company><Product>windock</Product><Title>windock</Title><Description>栖于桌边，触手可及</Description>
