<Window x:Class="SuperDock.SearchViews.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        Width="430"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="DialogBrush" Color="#1F2022" />
        <SolidColorBrush x:Key="DialogBorderBrush" Color="#3B3D42" />
        <SolidColorBrush x:Key="TileBrush" Color="#2B2D30" />
        <SolidColorBrush x:Key="TileHoverBrush" Color="#35373B" />
        <SolidColorBrush x:Key="LineBrush" Color="#3A3D42" />
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MutedBrush" Color="#98A2AE" />
        <SolidColorBrush x:Key="AccentBrush" Color="#8AB4F8" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#2A3542" />
        <SolidColorBrush x:Key="DangerBrush" Color="#3D2428" />
        <SolidColorBrush x:Key="DangerBorderBrush" Color="#8A4A52" />
        <SolidColorBrush x:Key="DangerTextBrush" Color="#FF7B72" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#8AB4F8" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111418" />

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource TileBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource DialogBrush}"
            BorderBrush="{DynamicResource DialogBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.38" Color="#000000" />
        </Border.Effect>

        <Grid Margin="22,20,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 图标 -->
            <Border x:Name="IconBadge"
                    Width="38"
                    Height="38"
                    CornerRadius="19"
                    VerticalAlignment="Top"
                    Background="{DynamicResource AccentSoftBrush}">
                <Grid>
                    <Path x:Name="IconGlyph"
                          Width="18"
                          Height="18"
                          Stretch="Uniform"
                          Stroke="{DynamicResource AccentBrush}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 标题与正文 -->
            <StackPanel Grid.Column="1" Margin="14,1,0,0">
                <TextBlock x:Name="TitleText"
                           FontSize="14.5"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="MessageText"
                           Margin="0,8,0,0"
                           FontSize="12.5"
                           LineHeight="20"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button x:Name="CancelButton"
                        Style="{StaticResource DialogButtonStyle}"
                        Margin="0,0,8,0"
                        Click="Cancel_Click" />
                <Button x:Name="ConfirmButton"
                        Style="{StaticResource DialogButtonStyle}"
                        Click="Confirm_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
