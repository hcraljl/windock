<Window x:Class="SuperDock.SearchViews.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SuperDock.SearchConverters"
        Title="搜索"
        Width="720"
        Height="500"
        MinWidth="560"
        MinHeight="360"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:ExecutableIconConverter x:Key="ExecutableIconConverter" />

        <SolidColorBrush x:Key="DialogBrush" Color="#1F2022" />
        <SolidColorBrush x:Key="DialogBorderBrush" Color="#3B3D42" />
        <SolidColorBrush x:Key="PanelBrush" Color="#252628" />
        <SolidColorBrush x:Key="TileBrush" Color="#2B2D30" />
        <SolidColorBrush x:Key="TileHoverBrush" Color="#35373B" />
        <SolidColorBrush x:Key="InputBrush" Color="#2A2C2F" />
        <SolidColorBrush x:Key="IconTileBrush" Color="#303236" />
        <SolidColorBrush x:Key="PreviewBrush" Color="#242527" />
        <SolidColorBrush x:Key="LineBrush" Color="#3A3D42" />
        <SolidColorBrush x:Key="ScrollTrackBrush" Color="#25272A" />
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#565A61" />
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#747A84" />
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MutedBrush" Color="#98A2AE" />
        <SolidColorBrush x:Key="AccentBrush" Color="#8AB4F8" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#2A3542" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#8AB4F8" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111418" />

        <!-- 细窄圆角滚动条 -->
        <Style x:Key="SlimScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="0,2,0,2">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Focusable="False"
                                                  Opacity="0"
                                                  Background="Transparent" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBody"
                                                        Width="5"
                                                        HorizontalAlignment="Center"
                                                        CornerRadius="3"
                                                        Background="{DynamicResource ScrollThumbBrush}" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                                                        <Setter TargetName="ThumbBody" Property="Width" Value="8" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                        <Setter TargetName="ThumbBody" Property="Width" Value="8" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Focusable="False"
                                                  Opacity="0"
                                                  Background="Transparent" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path Data="{Binding GlyphData}"
                                  Width="13"
                                  Height="13"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Stroke="{DynamicResource MutedBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />

                            <TextBlock Grid.Column="1"
                                       x:Name="CategoryLabel" Text="{Binding Label}"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextBrush}" />

                            <TextBlock Grid.Column="2"
                                       x:Name="CategoryCount" Text="{Binding CountText}"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource MutedBrush}" />
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource TileHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="7,4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource TileHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Row"
                                Background="Transparent"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="False" />
                                <TextBlock Grid.Column="1"
                                           Text="{TemplateBinding InputGestureText}"
                                           Margin="24,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource TileHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="Background" Value="{DynamicResource LineBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶部预览开关 -->
        <Style x:Key="PreviewToggleStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip"
                                Background="Transparent"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="9,3">
                            <TextBlock x:Name="Label"
                                       Text="预览"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource TileHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchChromeButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="9,3"/><Setter Property="Margin" Value="2,0"/><Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="OpaqueSearchMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource SearchMenuFill}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Opacity" Value="1"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Padding="5" MinWidth="224" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource SearchMenuBorder}" BorderThickness="1"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Resources>
                <Style TargetType="MenuItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="11,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="Row" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/><TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="22,0,0,0" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SearchMenuHover}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
                <Style TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Margin="7,5" Background="{DynamicResource SearchMenuBorder}"/></ControlTemplate></Setter.Value></Setter></Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="RootBorder"
                Background="{DynamicResource DialogBrush}"
                BorderBrush="{DynamicResource DialogBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                MouseLeftButtonDown="RootBorder_MouseLeftButtonDown"
                MouseMove="RootBorder_MouseMove"
                MouseLeftButtonUp="RootBorder_MouseLeftButtonUp">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="7" Opacity="0.38" Color="#000000" />
            </Border.Effect>

            <Grid Margin="14,12,14,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8" Height="28">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource SearchChromeButton}" Content="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="30" ToolTip="最小化" Click="Minimize_Click"/>
                        <Button x:Name="MaximizeButton" Style="{StaticResource SearchChromeButton}" Content="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="30" ToolTip="最大化 / 还原" Click="Maximize_Click"/>
                        <Button Style="{StaticResource SearchChromeButton}" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="30" ToolTip="关闭" Click="CloseSearch_Click"/>
                    </StackPanel>
                    <TextBlock Text="文件搜索" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                </DockPanel>
                <Border Grid.Row="1"
                        Background="{DynamicResource InputBrush}"
                        CornerRadius="10"
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Path Data="M10.5 4a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13zM15.6 15.6 20 20"
                              Width="15"
                              Height="15"
                              Stretch="Uniform"
                              Margin="0,0,9,0"
                              VerticalAlignment="Center"
                              Stroke="{DynamicResource MutedBrush}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />

                        <TextBox x:Name="QueryBox"
                                 Grid.Column="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="16"
                                 VerticalContentAlignment="Center"
                                 Foreground="{DynamicResource TextBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 TextChanged="QueryBox_TextChanged" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton x:Name="PreviewToggle"
                                          Style="{StaticResource PreviewToggleStyle}"
                                          IsChecked="{Binding PreviewEnabled, Mode=TwoWay}"
                                          ToolTip="开启 / 关闭右侧预览"
                                          Focusable="False" />
                            <TextBlock x:Name="SearchHotkeyHint" Text="Alt + 空格"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="CategoryColumn" Width="184" />
                        <ColumnDefinition Width="*" MinWidth="220" />
                        <ColumnDefinition x:Name="PreviewSplitterColumn" Width="0" />
                        <ColumnDefinition x:Name="PreviewColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <ItemsControl x:Name="CategoryList"
                                  Grid.Column="0"
                                  ItemsSource="{Binding Categories}"
                                  Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CategoryButtonStyle}"
                                        Content="{Binding}"
                                        Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Click="CategoryButton_Click" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Grid.Column="1" Margin="10,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel x:Name="ResultsToolbar" Grid.Row="0" Height="30" Visibility="Collapsed" Margin="0,0,0,8"><Button DockPanel.Dock="Left" Style="{StaticResource SearchChromeButton}" Content="☰" ToolTip="切换仅图标分类" Click="ToggleCategories_Click"/>                    <StackPanel x:Name="SortButtons" Orientation="Horizontal">
                        <Button Tag="相关度" Style="{StaticResource SearchChromeButton}" Background="{DynamicResource AccentSoftBrush}" Content="相关度" Click="Sort_Click"/>
                        <Button Tag="大小降序" Style="{StaticResource SearchChromeButton}" Content="大小 ↓" ToolTip="按文件大小从大到小" Click="Sort_Click"/>
                        <Button Tag="大小升序" Style="{StaticResource SearchChromeButton}" Content="大小 ↑" ToolTip="按文件大小从小到大" Click="Sort_Click"/>
                    </StackPanel></DockPanel>
                        <ListBox Grid.Row="1" x:Name="ResultsList"
                                 ItemsSource="{Binding Results}"
                                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource ResultItemStyle}"
                                 SelectionMode="Extended"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 MouseDoubleClick="ResultsList_MouseDoubleClick"
                                 PreviewMouseLeftButtonDown="ResultsList_PreviewMouseLeftButtonDown"
                                 SelectionChanged="ResultsList_SelectionChanged"
                                 ContextMenuOpening="ResultsList_ContextMenuOpening">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBarStyle}" />
                            </ListBox.Resources>
                            <ListBox.ContextMenu>
                                <ContextMenu Style="{StaticResource OpaqueSearchMenu}">
                                    <MenuItem x:Name="MenuMultiHeader"
                                              IsEnabled="False"
                                              Visibility="Collapsed" />
                                    <MenuItem x:Name="MenuOpen"
                                              Header="打开"
                                              InputGestureText="Enter"
                                              Click="MenuOpen_Click" />
                                    <MenuItem x:Name="MenuReveal"
                                              Header="打开所在位置"
                                              InputGestureText="Ctrl+Enter"
                                              Click="MenuReveal_Click" />
                                    <MenuItem Header="添加到 Dock" Click="MenuPin_Click" />
                                    <Separator x:Name="MenuSingleSeparator" />
                                    <MenuItem x:Name="MenuRename"
                                              Header="重命名…"
                                              InputGestureText="F2"
                                              Click="MenuRename_Click" />
                                    <MenuItem x:Name="MenuRecycle"
                                              Header="删除到回收站"
                                              Click="MenuRecycle_Click" />
                                    <MenuItem x:Name="MenuDelete"
                                              Header="彻底删除…"
                                              Click="MenuDelete_Click"
                                              Foreground="#FF7B72" />
                                    <Separator x:Name="MenuCopySeparator" />
                                    <MenuItem x:Name="MenuCopyName"
                                              Header="复制文件名"
                                              Click="MenuCopyName_Click" />
                                    <MenuItem x:Name="MenuCopyPath"
                                              Header="复制完整路径"
                                              Click="MenuCopyPath_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding ToolTip}"
                                          AutomationProperties.Name="{Binding Name}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                                            <Path Data="{Binding GlyphData}"
                                                  Width="15"
                                                  Height="15"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Stroke="{DynamicResource MutedBrush}"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Visibility="{Binding ShowGlyph, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Image Source="{Binding FullPath, Converter={StaticResource ExecutableIconConverter}}"
                                                   Width="18"
                                                   Height="18"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding HasExecutableIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13.5"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Directory}"
                                                       FontSize="11.5"
                                                       Margin="0,1,0,0"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SizeText}"
                                                   VerticalAlignment="Center"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Margin="0,0,4,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="1" HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,0,0,16"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding StatusText}"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                            <Button Content="重试启动"
                                    Width="128"
                                    Height="30"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource TileBrush}"
                                    Foreground="{DynamicResource TextBrush}"
                                    BorderBrush="{DynamicResource LineBrush}"
                                    Click="StartEverything_Click"
                                    Visibility="{Binding IsServiceUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <StackPanel Width="330"
                                        Margin="0,18,0,0"
                                        Visibility="{Binding IsHistoryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <TextBlock Text="最近搜索"
                                               FontSize="11.5"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedBrush}" />
                                    <Button Content="清空记录"
                                            HorizontalAlignment="Right"
                                            Padding="6,2"
                                            FontSize="11"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{DynamicResource MutedBrush}"
                                            Cursor="Hand"
                                            Click="ClearHistory_Click" />
                                </Grid>
                                <ScrollViewer MaxHeight="230"
                                              Margin="0,6,0,0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBarStyle}" />
                                    </ScrollViewer.Resources>
                                    <ItemsControl ItemsSource="{Binding History}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Content="{Binding}"
                                                            Tag="{Binding}"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Padding="8,5"
                                                            FontSize="12.5"
                                                            Background="{DynamicResource TileBrush}"
                                                            BorderThickness="0"
                                                            Foreground="{DynamicResource TextBrush}"
                                                            Cursor="Hand"
                                                            Click="HistoryItem_Click" />
                                                    <Button Grid.Column="1"
                                                            Content="×"
                                                            Tag="{Binding}"
                                                            Width="26"
                                                            Margin="3,0,0,0"
                                                            FontSize="14"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="{DynamicResource MutedBrush}"
                                                            Cursor="Hand"
                                                            ToolTip="删除这条记录"
                                                            Click="DeleteHistoryItem_Click" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </StackPanel>

                        <!-- 复制成功的短暂提示，不打断操作 -->
                        <Border Grid.Row="1" HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,14,10"
                                Padding="10,5"
                                CornerRadius="9"
                                IsHitTestVisible="False"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                Visibility="{Binding IsCopyHintVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M3.5 8.5 6.5 11.5 12.5 5"
                                      Width="12"
                                      Height="12"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <TextBlock Text="{Binding CopyHint}"
                                           FontSize="11.5"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <GridSplitter x:Name="PreviewSplitter"
                                  Grid.Column="2"
                                  Width="5"
                                  Margin="3,0"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="Transparent"
                                  ResizeDirection="Columns"
                                  ShowsPreview="False"
                                  Cursor="SizeWE"
                                  Visibility="Collapsed" />

                    <Border x:Name="PreviewPane"
                            Grid.Column="3"
                            Margin="4,0,0,0"
                            Background="{DynamicResource PreviewBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="文件预览"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}" />

                            <StackPanel Grid.Row="1" Margin="0,8,0,10">
                                <TextBlock Text="{Binding Preview.Title}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Preview.Meta}"
                                           Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock Text="{Binding Preview.Hint}"
                                           Margin="0,4,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Preview.HasHint, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>

                            <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><ContentControl x:Name="DocumentPreviewHost" Grid.Row="1"/>
                                <Image x:Name="LegacyPreviewImage" Grid.Row="1" Source="{Binding Preview.Image}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding Preview.HasImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBox x:Name="LegacyPreviewText" Grid.Row="1" Text="{Binding Preview.Text, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         FontSize="12"
                                         FontFamily="Consolas, Microsoft YaHei UI"
                                         Foreground="{DynamicResource TextBrush}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled"
                                         Visibility="{Binding Preview.HasText, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBox.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBarStyle}" />
                                    </TextBox.Resources>
                                </TextBox>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="3" Margin="2,8,2,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DetailText}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Text="{Binding SelectionSummary}"
                                   Margin="10,0,0,0"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Visibility="{Binding HasSelectionSummary, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"
                               Text="↑↓ 选择 · Enter 打开 · Ctrl+Enter 定位 · F2 重命名 · 右键更多 · Tab 切分类" />
                </Grid>
            </Grid>
        </Border>

        <Thumb x:Name="ResizeGrip"
               Width="18"
               Height="18"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Margin="0,0,3,3"
               Cursor="SizeNWSE"
               Opacity="0"
               DragDelta="ResizeGrip_DragDelta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M12 3 L3 12 M16 7 L7 16 M20 11 L11 20"
                              Stroke="{DynamicResource MutedBrush}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Opacity="0.5" />
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
